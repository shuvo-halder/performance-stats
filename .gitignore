# ============================================================================
# Server Stats Monitor - .gitignore
# Production-grade gitignore covering Python, Node, Docker, and IDE files
# ============================================================================

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual Environment ─────────────────────────────────────────────────
.env
.venv
venv/
env/
ENV/

# ── Database ────────────────────────────────────────────────────────────
*.db
*.sqlite
backend/data/

# ── Node / Frontend ─────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/build/

# ── Logs ────────────────────────────────────────────────────────────────
*.log
*.log.*

# ── Docker ──────────────────────────────────────────────────────────────
.docker/

# ── OS Files ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
~$*

# ── IDE / Editor ────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ── Secrets & Config ────────────────────────────────────────────────────
# Keep .env.example but ignore actual .env files with secrets
.env
*.key
*.pem
*.cert

# ── Backup Files ────────────────────────────────────────────────────────
*.bak
*.backup
*.orig

# ── Deployment ──────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.tgz