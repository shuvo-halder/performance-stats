# Server Stats Monitor - Configuration
DATABASE_URL=sqlite+aiosqlite:///./data/server-stats.db
API_KEY=sk-prod-server-stats-monitor-key-2026
API_KEY_NAME=X-API-Key
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Monitoring thresholds
CPU_THRESHOLD=80
MEM_THRESHOLD=85
DISK_THRESHOLD=90

# Services to monitor (comma-separated)
SERVICES=nginx,docker,mysql

# Auto-restart settings
AUTO_RESTART_FAILED_SERVICES=true
RESTART_ATTEMPTS=2
RESTART_DELAY=3

# Collection interval in seconds (for background scheduler)
COLLECTION_INTERVAL=60