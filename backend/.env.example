# ============================================================================
# Server Stats Monitor - Environment Configuration
# Copy this file to .env and customize for your deployment:
#   cp .env.example .env
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ── CORS (Frontend URLs that can access the API) ───────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/server-stats.db

# ── JWT Authentication ──────────────────────────────────────────────────────
# Generate a secure secret key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Master API Key (bypasses user auth for automated/system access) ─────────
# Generate with: python -c "import secrets; print('mk-' + secrets.token_hex(32))"
MASTER_API_KEY=sk-prod-server-stats-master-key-2026

# ── Monitoring Thresholds ───────────────────────────────────────────────────
CPU_THRESHOLD=80
MEM_THRESHOLD=85
DISK_THRESHOLD=90

# ── Services to Monitor ─────────────────────────────────────────────────────
SERVICES=nginx,docker,mysql

# ── Auto-Restart Settings ───────────────────────────────────────────────────
AUTO_RESTART_FAILED_SERVICES=true
RESTART_ATTEMPTS=2
RESTART_DELAY=3

# ── Background Collection ───────────────────────────────────────────────────
COLLECTION_INTERVAL=60

# ── IP Reputation / Threat Intelligence ──────────────────────────────
IP_REPUTATION_ENABLED=true
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
IPQUALITYSCORE_API_KEY=
IP_REPUTATION_CACHE_TTL=1800
IP_REPUTATION_ABUSE_THRESHOLD=70
IP_REPUTATION_MAX_REQUESTS_PER_IP=300
IP_REPUTATION_RATE_LIMIT=30
