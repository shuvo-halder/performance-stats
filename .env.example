# ============================================================================
# Server Stats Monitor - Docker Deployment Configuration
# Copy this file to .env and customize:
#   cp .env.example .env
# Then run: docker-compose up --build
# ============================================================================

# ── Port Configuration (change these if ports conflict) ─────────────────────
API_PORT=8000          # Backend API server port
DASHBOARD_PORT=8080    # Frontend dashboard port

# ── JWT Secret (REQUIRED: change for production!) ──────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-key-in-production

# ── Master API Key (for automated/system access) ────────────────────────────
# Generate with: python -c "import secrets; print('mk-' + secrets.token_hex(32))"
MASTER_API_KEY=sk-prod-server-stats-master-key-2026

# ── CORS (Frontend URLs allowed to access API) ──────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Monitoring Thresholds ───────────────────────────────────────────────────
CPU_THRESHOLD=80
MEM_THRESHOLD=85
DISK_THRESHOLD=90

# ── Services to Monitor ─────────────────────────────────────────────────────
SERVICES=nginx,docker,mysql

# ── Background Collection Interval (seconds) ────────────────────────────────
COLLECTION_INTERVAL=60

# ── IP Reputation / Threat Intelligence ──────────────────────────────
# Enable IP reputation checking (default: true)
IP_REPUTATION_ENABLED=true

# AbuseIPDB API (free tier: 1000 requests/day)
# Register at: https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=

# VirusTotal API (free tier: 500 requests/day, 4 requests/min)
# Register at: https://www.virustotal.com/
VIRUSTOTAL_API_KEY=

# IPQualityScore API
# Register at: https://www.ipqualityscore.com/
IPQUALITYSCORE_API_KEY=

# Cache TTL for IP reputation in seconds (default: 1800 = 30 min)
IP_REPUTATION_CACHE_TTL=1800

# Abuse score threshold for alerting (0-100, default: 70)
IP_REPUTATION_ABUSE_THRESHOLD=70

# Max requests per IP before triggering alert (default: 300)
IP_REPUTATION_MAX_REQUESTS_PER_IP=300

# Rate limit for external API calls per minute (default: 30)
IP_REPUTATION_RATE_LIMIT=30
