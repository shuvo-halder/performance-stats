# ============================================================================
# Server Stats Monitor - Docker Deployment Configuration
# Copy this file to .env and customize:
#   cp .env.example .env
# Then run: docker-compose up --build
# ============================================================================

# ── Port Configuration (change these if ports conflict) ─────────────────────
API_PORT=8000          # Backend API server port
DASHBOARD_PORT=8080    # Frontend dashboard port

# ── JWT Secret (REQUIRED: change for production!) ──────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-key-in-production

# ── Master API Key (for automated/system access) ────────────────────────────
# Generate with: python -c "import secrets; print('mk-' + secrets.token_hex(32))"
MASTER_API_KEY=sk-prod-server-stats-master-key-2026

# ── CORS (Frontend URLs allowed to access API) ──────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Monitoring Thresholds ───────────────────────────────────────────────────
CPU_THRESHOLD=80
MEM_THRESHOLD=85
DISK_THRESHOLD=90

# ── Services to Monitor ─────────────────────────────────────────────────────
SERVICES=nginx,docker,mysql

# ── Background Collection Interval (seconds) ────────────────────────────────
COLLECTION_INTERVAL=60